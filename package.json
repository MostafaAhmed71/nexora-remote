{
  "name": "nexora-remote",
  "version": "0.3.0",
  "description": "Auditable multi-tenant Windows remote desktop engineering preview",
  "main": "index.js",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p apps/web/tsconfig.json",
    "build": "tsc && vite build --config apps/web/vite.config.ts",
    "test": "vitest run",
    "dev": "node --import tsx apps/server/src/main.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "migrate": "node --import tsx packages/database/migrate.ts",
    "bootstrap": "node --import tsx infrastructure/local/bootstrap.ts",
    "test:e2e": "playwright test",
    "lint": "prettier --check apps/web apps/server packages tests infrastructure scripts .github *.json *.ts && node scripts/lint.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@fastify/websocket": "^11.3.4",
    "@tanstack/react-query": "^5.104.5",
    "argon2": "^0.45.1",
    "fastify": "^5.12.7",
    "lucide-react": "^1.61.0",
    "otpauth": "^9.5.2",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "private": true
}
